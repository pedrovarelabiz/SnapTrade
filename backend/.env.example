# ---------------------------------------------------------------------------
# Backup Configuration
# ---------------------------------------------------------------------------

# AWS IAM access key ID — needs s3:PutObject / s3:GetObject / s3:DeleteObject
# on the backup bucket. Create a dedicated IAM user with least-privilege policy.
AWS_ACCESS_KEY_ID=<aws-access-key-id>

# Corresponding AWS IAM secret access key for the above key ID
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>

# AWS region that hosts the S3 backup bucket (e.g. us-east-1, eu-west-1)
AWS_REGION=<aws-region>

# Name of the primary S3 bucket used for storing backup archives
S3_BACKUP_BUCKET=<s3-bucket-name>

# Legacy alias for S3_BACKUP_BUCKET — kept for backwards-compatibility with
# older scripts; should point to the same bucket
BACKUP_S3_BUCKET=<s3-bucket-name>

# 64-character (32-byte) hex string used to AES-256 encrypt backup archives
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=<64-char-hex-encryption-key>

# Absolute path on the host where local backup copies are written
BACKUP_LOCAL_DIR=/var/backups/<project-name>

# Number of days to keep old backups before the cleanup job removes them
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Alert / Notification
# ---------------------------------------------------------------------------

# Telegram bot token used to send backup status and health-check alerts
# Obtain from @BotFather on Telegram
ALERT_BOT_TOKEN=<telegram-bot-token>

# Telegram chat or channel ID that should receive alert messages
# Use a negative integer for group/supergroup/channel chats
ALERT_CHAT_ID=<telegram-chat-id>

# ---------------------------------------------------------------------------
# Application / Auth
# ---------------------------------------------------------------------------

# Full PostgreSQL connection URL used by the application and migration tooling
DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:<db-port>/<db-name>

# Long random string used to sign and verify JWT tokens
# Generate with: openssl rand -base64 48
JWT_SECRET=<long-random-jwt-secret>

# Shared secret for internal service-to-service API calls
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=<random-api-key>

# ---------------------------------------------------------------------------
# Transactional Email — Resend
# ---------------------------------------------------------------------------

# API key for the Resend transactional email service
# Create at: https://resend.com/api-keys
# Required for password reset emails to be delivered
RESEND_API_KEY=re_<your-resend-api-key>

# From address used in outbound transactional emails
# Must be a verified sender domain in your Resend account
EMAIL_FROM=no-reply@yourdomain.com

# ---------------------------------------------------------------------------
# Database (individual parameters — for scripts that don't support DATABASE_URL)
# ---------------------------------------------------------------------------

DB_HOST=<db-host>
DB_NAME=<db-name>
DB_USER=<db-user>
DB_PASSWORD=<db-password>
DB_PORT=5432
# Set to true to enforce TLS/SSL for all database connections in production
DB_SSL=false

# ---------------------------------------------------------------------------
# Sentry — Error & Performance Monitoring
# ---------------------------------------------------------------------------

# DSN for the primary Sentry project
# Found at: Sentry → Project Settings → Client Keys (DSN)
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# DSN for the backend-specific Sentry project (may be the same as SENTRY_DSN
# or a separate project for backend-only events)
SENTRY_DSN_BACKEND=https://<key>@<org>.ingest.sentry.io/<project-id>

# Environment tag attached to every Sentry event (development | staging | production)
SENTRY_ENVIRONMENT=<environment>

# Fraction of transactions to sample for Sentry performance monitoring (0.0–1.0)
# 0.1 = 10 % of transactions; use 1.0 only in development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Node.js runtime environment (development | staging | production)
NODE_ENV=<environment>

# Public URL of the frontend — used to construct password-reset links
FRONTEND_URL=https://app.yourdomain.com

# ---------------------------------------------------------------------------
# Legacy Local-Backup Options
# ---------------------------------------------------------------------------

# Whether to retain a local copy of each backup after uploading to S3
KEEP_LOCAL_BACKUP_COPY=true

# Temporary local directory used during backup creation (legacy)
LOCAL_BACKUP_DIR=/tmp/<project-name>-backups
