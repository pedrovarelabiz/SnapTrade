{
  "name": "snaptrade-backend",
  "version": "1.0.0",
  "description": "SnapTrade Backend API",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc && npm run build:backup-scripts",
    "build:backup-scripts": "tsc -p tsconfig.backup.json",
    "seed": "tsx prisma/seed.ts",
    "migrate": "npx prisma migrate dev",
    "generate": "npx prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "backup:run": "tsx scripts/db-backup.ts",
    "backup:restore": "tsx scripts/restore-backup.ts",
    "backup:verify": "tsx scripts/verify-backup.ts",
    "backup:cleanup": "tsx scripts/cleanup-old-backups.ts",
    "backup:generate-key": "tsx scripts/generate-encryption-key.ts",
    "backup:scheduler": "tsx scripts/backup-scheduler.ts",
    "backup:validate-config": "tsx scripts/validate-backup-config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.86",
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@google/generative-ai": "^0.24.1",
    "@ixjb94/indicators": "^1.2.4",
    "@paypal/checkout-server-sdk": "^1.0.3",
    "@prisma/client": "^6.5.0",
    "@sentry/node": "^7.120.4",
    "@sentry/profiling-node": "^7.120.4",
    "@sentry/tracing": "^7.120.4",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.0",
    "resend": "^6.9.4",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.0",
    "aws-sdk-client-mock": "^4.1.0",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
