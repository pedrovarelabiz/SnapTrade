{
  "dashboard": {
    "title": "SSE Metrics Dashboard",
    "uid": "sse-metrics",
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "type": "gauge",
        "title": "SSE Active Connections by Endpoint",
        "targets": [
          {
            "expr": "sse_active_connections",
            "legendFormat": "{{endpoint}}",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 80,
                  "color": "yellow"
                },
                {
                  "value": 100,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "id": 2,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "type": "gauge",
        "title": "SSE Connection Age (Seconds)",
        "targets": [
          {
            "expr": "sse_connection_age_seconds",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "unit": "s",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 300,
                  "color": "yellow"
                },
                {
                  "value": 600,
                  "color": "red"
                }
              ]
            }
          }
        }
      },
      {
        "id": 3,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "type": "graph",
        "title": "SSE Disconnects Total by Reason",
        "targets": [
          {
            "expr": "rate(sse_disconnects_total[5m])",
            "legendFormat": "{{reason}}",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Rate",
            "min": 0
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "values": true,
          "current": true
        }
      },
      {
        "id": 4,
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "type": "graph",
        "title": "SSE Rejected Connections Total",
        "targets": [
          {
            "expr": "rate(sse_rejected_connections_total[5m])",
            "legendFormat": "Rejected",
            "refId": "A"
          }
        ],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "yaxes": [
          {
            "format": "short",
            "label": "Rate",
            "min": 0
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "show": true,
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "values": true,
          "current": true
        }
      }
    ]
  }
}
