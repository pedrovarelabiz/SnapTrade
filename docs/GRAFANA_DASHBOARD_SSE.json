{
  "dashboard": {
    "title": "SSE Monitoring Dashboard",
    "uid": "sse-monitoring",
    "version": 1,
    "timezone": "browser",
    "schemaVersion": 38,
    "tags": ["sse", "monitoring"],
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "gauge",
        "title": "Active Connections",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "sse_active_connections",
            "refId": "A",
            "legendFormat": "Active Connections"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 80,
                  "color": "yellow"
                },
                {
                  "value": 100,
                  "color": "red"
                }
              ]
            },
            "unit": "short"
          }
        }
      },
      {
        "id": 2,
        "type": "gauge",
        "title": "Utilization Percentage",
        "gridPos": {
          "h": 8,
          "w": 6,
          "x": 6,
          "y": 0
        },
        "targets": [
          {
            "expr": "(sse_active_connections / sse_max_connections) * 100",
            "refId": "A",
            "legendFormat": "Utilization %"
          }
        ],
        "options": {
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "percentage",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 70,
                  "color": "yellow"
                },
                {
                  "value": 90,
                  "color": "red"
                }
              ]
            },
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        }
      },
      {
        "id": 3,
        "type": "graph",
        "title": "Connection Rate",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "rate(sse_connections_total[5m])",
            "refId": "A",
            "legendFormat": "Connection Rate"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Connections/sec"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "id": 4,
        "type": "graph",
        "title": "Rejection Rate",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(sse_rejections_total[5m])",
            "refId": "A",
            "legendFormat": "Rejection Rate"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Rejections/sec"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        },
        "alert": {
          "conditions": [
            {
              "evaluator": {
                "params": [0.1],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": ["A", "5m", "now"]
              },
              "reducer": {
                "params": [],
                "type": "avg"
              },
              "type": "query"
            }
          ]
        }
      },
      {
        "id": 5,
        "type": "graph",
        "title": "Timeout Rate",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 8,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(sse_timeouts_total[5m])",
            "refId": "A",
            "legendFormat": "Timeout Rate"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Timeouts/sec"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        }
      },
      {
        "id": 6,
        "type": "graph",
        "title": "Message Error Rate",
        "gridPos": {
          "h": 8,
          "w": 8,
          "x": 16,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(sse_message_errors_total[5m])",
            "refId": "A",
            "legendFormat": "Error Rate"
          }
        ],
        "yaxes": [
          {
            "format": "short",
            "label": "Errors/sec"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true
        },
        "seriesOverrides": [
          {
            "alias": "Error Rate",
            "color": "#F2495C"
          }
        ]
      },
      {
        "id": 7,
        "type": "graph",
        "title": "Connection Duration P95",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(sse_connection_duration_seconds_bucket[5m]))",
            "refId": "A",
            "legendFormat": "P95 Duration"
          },
          {
            "expr": "histogram_quantile(0.50, rate(sse_connection_duration_seconds_bucket[5m]))",
            "refId": "B",
            "legendFormat": "P50 Duration"
          },
          {
            "expr": "histogram_quantile(0.99, rate(sse_connection_duration_seconds_bucket[5m]))",
            "refId": "C",
            "legendFormat": "P99 Duration"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration"
          },
          {
            "format": "short"
          }
        ],
        "xaxis": {
          "mode": "time"
        },
        "lines": true,
        "fill": 1,
        "linewidth": 2,
        "pointradius": 5,
        "legend": {
          "show": true,
          "alignAsTable": true,
          "avg": true,
          "current": true,
          "max": true,
          "min": true
        }
      }
    ]
  }
}
