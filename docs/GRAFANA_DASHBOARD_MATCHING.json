{
  "dashboard": {
    "title": "Matching Metrics Dashboard",
    "description": "Dashboard for monitoring matching service performance and tier distribution",
    "tags": ["matching", "metrics", "health"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "type": "piechart",
        "title": "Matching Tier Distribution",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "matching_stats_tier1_total",
            "legendFormat": "Tier 1 (Exact Match)",
            "refId": "A"
          },
          {
            "expr": "matching_stats_tier2_total",
            "legendFormat": "Tier 2 (Fuzzy Match)",
            "refId": "B"
          },
          {
            "expr": "matching_stats_tier3_total",
            "legendFormat": "Tier 3 (Manual Review)",
            "refId": "C"
          }
        ],
        "options": {
          "pieType": "pie",
          "displayLabels": ["name", "percent"],
          "legend": {
            "displayMode": "table",
            "placement": "right",
            "values": ["value", "percent"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            }
          }
        }
      },
      {
        "id": 2,
        "type": "timeseries",
        "title": "Ambiguous Matches Over Time",
        "gridPos": {
          "x": 12,
          "y": 0,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(matching_stats_ambiguous_matches_total[5m])",
            "legendFormat": "Ambiguous Matches (per 5m)",
            "refId": "A"
          }
        ],
        "options": {
          "tooltip": {
            "mode": "multi"
          },
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10,
              "showPoints": "auto"
            }
          }
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Match Success Rate",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "(matching_stats_successful_matches_total / matching_stats_total_attempts_total) * 100",
            "legendFormat": "Success Rate",
            "refId": "A"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value",
          "orientation": "auto",
          "textMode": "value_and_name",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 2,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 80,
                  "color": "yellow"
                },
                {
                  "value": 95,
                  "color": "green"
                }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "type": "gauge",
        "title": "Average Matching Time",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 6
        },
        "targets": [
          {
            "expr": "matching_stats_average_duration_milliseconds",
            "legendFormat": "Avg Time",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "values": false,
            "calcs": ["lastNotNull"]
          },
          "showThresholdLabels": true,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "decimals": 1,
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 500,
                  "color": "yellow"
                },
                {
                  "value": 1000,
                  "color": "red"
                }
              ]
            },
            "min": 0,
            "max": 2000
          }
        }
      }
    ],
    "templating": {
      "list": []
    },
    "annotations": {
      "list": []
    }
  },
  "meta": {
    "type": "db",
    "canSave": true,
    "canEdit": true,
    "canAdmin": true,
    "canStar": true,
    "slug": "matching-metrics-dashboard",
    "url": "",
    "expires": "0001-01-01T00:00:00Z",
    "created": "2026-03-23T00:00:00Z",
    "updated": "2026-03-23T00:00:00Z",
    "updatedBy": "admin",
    "createdBy": "admin",
    "version": 1
  }
}
