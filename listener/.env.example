# Telegram API Credentials
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
TELEGRAM_PHONE=+15555550100

# Backend Configuration
# URL of the backend API server (API_BASE is accepted as a backward-compatible alias)
BACKEND_URL=http://localhost:3001

# Internal API Key
# Must be at least 20 characters; used to authenticate requests to the backend
INTERNAL_API_KEY=your-internal-api-key-min-20-chars

# Sentry Configuration
# Obtain the DSN from your Sentry project settings
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Environment label reported to Sentry (e.g. production, staging, development)
ENVIRONMENT=production
# Release version tag reported to Sentry
RELEASE_VERSION=1.0.0

# Alert Bot Configuration
# Telegram bot token for sending crash alerts
ALERT_BOT_TOKEN=your_alert_bot_token_here
# Telegram chat ID where alerts are delivered
ALERT_CHAT_ID=your_alert_chat_id_here
# Set to false to suppress crash alerts
ENABLE_CRASH_ALERTS=true

# Reconnection Settings (seconds)
INITIAL_RECONNECT_DELAY_SECONDS=1
MAX_RECONNECT_DELAY_SECONDS=60

# Health Check
HEALTHCHECK_PORT=8888

# Signal Matching
# Enable verbose debug logging for signal matching
SIGNAL_MATCHING_DEBUG=false
# Tolerance window for exact expiration matching - Tier 1 (seconds)
EXACT_MATCH_TOLERANCE_SECONDS=5
# Fallback proximity window - Tier 3 (minutes)
PROXIMITY_MATCH_WINDOW_MINUTES=30
