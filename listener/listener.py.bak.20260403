ALERT_CHAT_ID = os.getenv("ALERT_CHAT_ID")
ENABLE_CRASH_ALERTS = os.getenv("ENABLE_CRASH_ALERTS", "true").lower() == "true"

UTC = timezone.utc


# --- Telegram alerting ---


async def send_alert(session: aiohttp.ClientSession, message: str) -> None:
    """Send alert to Telegram admin chat. Fails silently if not configured."""
    if not ALERT_BOT_TOKEN or not ALERT_CHAT_ID:
        return
    try:
        url = f"https://api.telegram.org/bot{ALERT_BOT_TOKEN}/sendMessage"
        await session.post(
            url,
            json={"chat_id": ALERT_CHAT_ID, "text": message},
            timeout=aiohttp.ClientTimeout(total=5),
        )
    except Exception:
        pass


def format_crash_report(exception: Exception, context: dict) -> str:
    """Format exception details into a readable crash report.

    Args:
        exception: The exception that occurred
        context: Additional context dictionary (e.g., channel, message_id)

    Returns:
        Formatted crash report string with exception type, message, traceback, timestamp, and context
    """
    timestamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC")
    exc_type = type(exception).__name__
    exc_message = str(exception)
    tb_lines = traceback.format_tb(exception.__traceback__)

    # Determine severity emoji
    critical_exceptions = (
        "SystemExit",
        "KeyboardInterrupt",
        "MemoryError",
        "RuntimeError",
    )
    severity_emoji = "🔴 CRITICAL" if exc_type in critical_exceptions else "🟡 WARNING"

    # Get first 5 lines of traceback
    tb_first_5 = "".join(tb_lines[:5])

    # Format context
    context_str = (
        "\n".join(f"  {k}: {v}" for k, v in context.items()) if context else "  (none)"
    )

    report = f"""<b>🚨 Listener Crash Alert</b>

{severity_emoji}
<b>Timestamp:</b> {timestamp}
<b>Exception:</b> {exc_type}
<b>Message:</b> {exc_message}

<b>Traceback:</b>
{tb_first_5}

<b>Context:</b>
{context_str}
"""

    # Ensure under 4096 chars (Telegram message limit)
    if len(report) > 4096:
        report = report[:4093] + "..."

    return report


class TelegramAlerter:
    """Telegram alerter for sending formatted alerts via Bot API."""

    def __init__(self, bot_token: str, chat_id: str):
        """Initialize with bot token and chat ID."""
        self.bot_token = bot_token
        self.chat_id = chat_id
        self.last_alert_time: Dict[str, datetime] = (
            {}
        )  # Track last alert time by message type

    async def send_alert(self, message: str, severity: str) -> None:
        """Send alert message to Telegram with severity level.

        Args:
            message: Alert message text
            severity: Severity level (info, warning, error, critical)
        """
        # Map severity to emoji
        severity_emojis = {
            "info": "ℹ️",
            "warning": "⚠️",
            "error": "🚨",
            "critical": "💥",
        }

        emoji = severity_emojis.get(severity.lower(), "ℹ️")
        formatted_message = f"{emoji} <b>{severity.upper()}</b>\n{message}"

        # Rate limiting: don't send duplicate alerts within 60 seconds
        alert_key = f"{severity}:{message}"
        now = datetime.now(timezone.utc)

        if alert_key in self.last_alert_time:
            time_since_last = (now - self.last_alert_time[alert_key]).total_seconds()
            if time_since_last < 60:
                logger.info("Alert suppressed (rate limit)")
                return

        try:
            async with aiohttp.ClientSession() as session:
                url = f"https://api.telegram.org/bot{self.bot_token}/sendMessage"
                print(f"Posting to {url}")
                await session.post(
                    url,
                    json={
                        "chat_id": self.chat_id,
                        "text": formatted_message,
                        "parse_mode": "HTML",
                    },
                )
            self.last_alert_time[alert_key] = now
        except Exception as e:
            print(f"Failed to send alert: {e}")


